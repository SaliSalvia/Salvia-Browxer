<?xml version="1.0" encoding="utf-8"?>
<!-- File: app/src/main/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.salvia.browxer">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- For Android 10+ -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="29" />

    <application
        android:name=".ui.MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SalviaBrowxer"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!-- Hardware acceleration for WebView -->
        <meta-data
            android:name="android.webkit.WebView.EnableHardwareAcceleration"
            android:value="true" />

        <!-- Enable WebView debugging -->
        <meta-data
            android:name="android.webkit.WebView.DebuggingEnabled"
            android:value="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SalviaBrowxer"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Download Service -->
        <service
            android:name=".service.DownloadService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|networkUsage" />

        <!-- WebView Activity for handling links -->
        <activity
            android:name=".ui.WebViewActivity"
            android:exported="true"
            android:theme="@style/Theme.SalviaBrowxer" />

        <!-- Settings Activity -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/settings"
            android:theme="@style/Theme.SalviaBrowxer" />

        <!-- Download Manager Activity -->
        <activity
            android:name=".ui.DownloadManagerActivity"
            android:exported="true"
            android:label="@string/downloads"
            android:theme="@style/Theme.SalviaBrowxer" />

        <!-- File Picker Activity -->
        <activity
            android:name=".ui.FilePickerActivity"
            android:exported="true"
            android:theme="@style/Theme.SalviaBrowxer" />
    </application>

</manifest>
