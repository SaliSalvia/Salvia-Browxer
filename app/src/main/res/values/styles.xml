<?xml version="1.0" encoding="utf-8"?>
<!-- File: app/src/main/res/values/styles.xml -->
<resources>
    <!-- Base application theme -->
    <style name="Theme.SalviaBrowxer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimary</item>
        
        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondary</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorBackground">@color/colorBackground</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurface</item>
        
        <!-- Error colors -->
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        
        <!-- Status bar and navigation bar -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">@color/colorBackground</item>
        
        <!-- Text appearance -->
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
    </style>

    <!-- Dark theme -->
    <style name="Theme.SalviaBrowxer.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimaryDark</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimaryDark</item>
        <item name="colorSecondary">@color/colorSecondaryDark</item>
        <item name="colorOnSecondary">@color/colorOnSecondaryDark</item>
        <item name="android:colorBackground">@color/colorBackgroundDark</item>
        <item name="colorBackground">@color/colorBackgroundDark</item>
        <item name="colorOnBackground">@color/colorOnBackgroundDark</item>
        <item name="colorSurface">@color/colorSurfaceDark</item>
        <item name="colorOnSurface">@color/colorOnSurfaceDark</item>
    </style>

    <!-- Toolbar theme -->
    <style name="ToolbarTheme" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
    </style>

    <!-- Card theme -->
    <style name="CardTheme" parent="Widget.Material3.Card">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">8dp</item>
    </style>

    <!-- Button styles -->
    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
    </style>

    <style name="SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <!-- Text styles -->
    <style name="TextTitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextTitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextBodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextBodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <!-- Progress bar -->
    <style name="ProgressBar" parent="Widget.Material3.ProgressBar.Linear">
        <item name="progressTint">@color/progressBarColor</item>
        <item name="trackTint">@color/progressBackground</item>
    </style>

    <!-- Switch -->
    <style name="Switch" parent="Widget.Material3.Switch">
        <item name="thumbTint">@color/colorPrimary</item>
        <item name="trackTint">@color/colorPrimaryVariant</item>
    </style>

    <!-- Text input -->
    <style name="TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/textSecondary</item>
    </style>

    <!-- Dialog -->
    <style name="DialogTheme" parent="ThemeOverlay.Material3">
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
    </style>

    <!-- Bottom navigation -->
    <style name="BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemTextColor">@color/textPrimary</item>
        <item name="itemIconTint">@color/textPrimary</item>
        <item name="itemRippleColor">@color/colorPrimary</item>
    </style>

    <!-- Floating action button -->
    <style name="FloatingActionButton" parent="Widget.Material3.FloatingActionButton">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="tint">@color/colorOnPrimary</item>
    </style>
</resources>
